APP_NAME="Garda ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://garda-erp.local
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=garda_erp_prod
DB_USERNAME=garda
DB_PASSWORD=

BROADCAST_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BACKUP_ARCHIVE_PASSWORD= # Wajib diisi untuk enkripsi ZIP backup

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@garda.local"
MAIL_FROM_NAME="${APP_NAME}"
